  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/create-app.git"
  },
  "author": "Ascensio System SIA",
  "maintainers": [
    "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
  ],
  "keywords": [
