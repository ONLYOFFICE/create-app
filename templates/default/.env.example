# ---------------------------------------------------------------------------
# ONLYOFFICE Docs connection
# ---------------------------------------------------------------------------

# URL of ONLYOFFICE Docs (Document Server) as reachable from the user's BROWSER.
# Required.
DOCUMENT_SERVER_URL=http://localhost:8080/

# URL of ONLYOFFICE Docs as reachable from THIS APPLICATION (server side).
# Only needed when it differs from DOCUMENT_SERVER_URL, e.g. inside Docker networks.
# Defaults to DOCUMENT_SERVER_URL.
DOCUMENT_SERVER_INTERNAL_URL=

# JWT secret configured in the Document Server (services.CoAuthoring.secret / JWT_SECRET).
# Leave empty only if JWT is disabled on the Document Server (not recommended).
DOCUMENT_SERVER_JWT_SECRET=developer-only-not-a-real-secret

# HTTP header the Document Server uses to send JWT (services.CoAuthoring.token.inbox.header).
DOCUMENT_SERVER_JWT_HEADER=Authorization

# ---------------------------------------------------------------------------
# This application
# ---------------------------------------------------------------------------

# Public base URL of THIS application as reachable from the Document Server.
# The Document Server downloads files from here and posts save callbacks here,
# so "localhost" only works when both run on the same host without containers.
# Example: http://192.168.1.10:3000
APP_URL=http://localhost:3000

# Extra host names allowed to open the DEVELOPMENT server (npm run dev), comma-separated.
# The host of APP_URL is always allowed. Not needed for npm start.
ALLOWED_DEV_ORIGINS=

# Editor UI language and the locale of blank templates used for "New document"
# (folder name in ./document-templates/new, e.g. en-US, ru-RU, de-DE, zh-CN).
DOCS_LANG=en-US

# The single demo user the editor is opened as.
DEMO_USER_ID=demo-user
DEMO_USER_NAME=Demo User

# Folder where uploaded documents are stored (relative to the project root or absolute).
STORAGE_DIR=storage
